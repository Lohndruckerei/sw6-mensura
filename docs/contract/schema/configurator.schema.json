{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lohndruckerei.eu/mensura/contract/configurator.schema.json",
  "title": "Konfigurator-Daten eines Produkts",
  "description": "Antwort von GET /store-api/ld-mensura/product/{productId}/configurator. Alles, was das Frontend zum Aufbau braucht – ohne Einkaufspreise. Preise berechnet ausschließlich das Backend (calculate).",
  "type": "object",
  "required": ["apiVersion", "productId", "layout", "materials", "groups", "sets", "defaults"],
  "properties": {
    "apiVersion": { "const": 1 },
    "productId": { "$ref": "#/$defs/id" },
    "layout": { "enum": ["compact", "guided"], "description": "Darstellung laut Produktprofil bzw. Plugin-Einstellung" },
    "allowLayoutSwitch": { "type": "boolean" },
    "steps": {
      "type": "array",
      "description": "Schritte der geführten Darstellung in Reihenfolge",
      "items": { "type": "object", "required": ["key", "label"], "properties": { "key": { "type": "string" }, "label": { "type": "string" } } }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "technicalName", "name", "calculation", "optionSet", "limits"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "technicalName": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "image": { "type": ["string", "null"], "description": "Medien-URL" },
          "badges": { "type": "array", "items": { "type": "string" } },
          "calculation": {
            "type": "object",
            "required": ["technicalName", "name", "motifMode"],
            "properties": {
              "technicalName": { "type": "string" },
              "name": { "type": "string" },
              "motifMode": { "enum": ["multiply", "split"] }
            }
          },
          "optionSet": { "type": "string", "description": "technischer Name des Folge-Sets" },
          "fromPricePerSqm": { "type": ["number", "null"], "description": "„ab“-Preis netto je m² für Kacheln" },
          "defaults": {
            "type": "object",
            "description": "optional: Vorbelegung je Optionsgruppe für dieses Material = jeweils der günstigste erlaubte Wert (Regel: immer den günstigsten Fall vorauswählen). Gilt, wenn eine Gruppe neu erscheint oder ihr Wert beim Materialwechsel nicht mehr erlaubt ist; Vorrang vor defaults.options",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "limits": { "$ref": "#/$defs/limits" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["technicalName", "name", "type", "displayType", "required", "values"],
        "properties": {
          "technicalName": { "type": "string" },
          "name": { "type": "string" },
          "helpText": { "type": ["string", "null"] },
          "type": { "enum": ["standard", "delivery", "format"] },
          "scope": { "enum": ["position", "supplier"] },
          "displayType": { "enum": ["select", "tiles", "radio", "checkbox", "number", "multi"] },
          "required": { "type": "boolean" },
          "mode": { "enum": ["inherit", "restrict", "fixed", "hidden"], "description": "Regel aus dem Produktprofil; hidden = nicht anzeigen, Wert steht in defaults" },
          "showPriceHint": { "type": "boolean", "description": "optional, Standard true: false = Aufpreise (priceHint) der Werte dieser Gruppe im Shop nicht anzeigen, Fokus auf den Gesamtpreis" },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["technicalName", "name"],
              "properties": {
                "technicalName": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": ["string", "null"] },
                "image": { "type": ["string", "null"] },
                "badges": { "type": "array", "items": { "type": "string" } },
                "priceHint": { "type": ["string", "null"], "description": "Anzeige-Text, z. B. „+ 9,00 €/m²“ – nur Anzeige, nie rechnen" },
                "width": { "type": ["integer", "null"] },
                "height": { "type": ["integer", "null"] },
                "deliveryDays": { "type": ["integer", "null"] },
                "optionSet": { "type": ["string", "null"], "description": "Folge-Set nach Wahl dieses Werts" },
                "availableForMaterials": { "type": "array", "items": { "type": "string" }, "description": "technische Namen; leer/fehlt = alle" }
              }
            }
          }
        }
      }
    },
    "sets": {
      "type": "object",
      "description": "Set (technischer Name) → Gruppen in Reihenfolge",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "startSet": { "type": ["string", "null"] },
    "defaults": { "$ref": "configuration.schema.json" },
    "quantitySteps": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "Zeilen der Preismatrix" },
    "orderCutoff": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$", "description": "Annahmeschluss, z. B. 11:30" },
    "display": {
      "type": "object",
      "description": "optional: was der Shop dem Käufer neben dem Gesamtpreis zeigt (Plugin-Einstellung bzw. Produktprofil). Fehlt ein Schalter = true",
      "additionalProperties": false,
      "properties": {
        "showPriceHints": { "type": "boolean", "description": "Aufpreise an Optionswerten (priceHint); je Gruppe zusätzlich showPriceHint" },
        "showArea": { "type": "boolean", "description": "Fläche (Breite × Höhe × Stück) und abgerechnete Fläche" },
        "showPerSqm": { "type": "boolean", "description": "Preis je m²" },
        "showPerPiece": { "type": "boolean", "description": "Preis je Stück" },
        "showFromPrice": { "type": "boolean", "description": "„ab“-Preis je m² an Material-Kacheln (fromPricePerSqm)" }
      }
    },
    "layoutTest": {
      "type": "object",
      "description": "optional: Testbetrieb der Darstellungen (KONZEPT 3c, Plugin-Einstellung layoutTestShare). Neue Besucher ohne eigene Wahl bekommen mit der Wahrscheinlichkeit share % die andere als die Standard-Darstellung (layout); die Zuteilung merkt sich der Browser. Fehlt oder share = 0: kein Test",
      "additionalProperties": false,
      "required": ["share"],
      "properties": {
        "share": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Anteil in Prozent, z. B. 20 = jeder fünfte neue Besucher sieht die andere Darstellung" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "limits": {
      "type": "object",
      "properties": {
        "widthMin": { "type": "integer" }, "widthMax": { "type": "integer" },
        "heightMin": { "type": "integer" }, "heightMax": { "type": "integer" },
        "allowRotation": { "type": "boolean" },
        "maxMotifs": { "type": ["integer", "null"] }, "maxQuantity": { "type": ["integer", "null"] }
      }
    }
  }
}
