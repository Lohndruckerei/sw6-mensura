<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <!-- Stammdaten -->
        <service id="Lohndruckerei\Mensura\Core\Content\Calculation\CalculationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_calculation"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Calculation\Aggregate\CalculationMaterial\CalculationMaterialDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_calculation_material"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Calculation\Aggregate\CalculationOptionValue\CalculationOptionValueDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_calculation_option_value"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Calculation\Aggregate\CalculationCustomerGroup\CalculationCustomerGroupDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_customer_group_rule"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Material\MaterialDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_material"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Material\Aggregate\MaterialTranslation\MaterialTranslationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_material_translation"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Option\OptionGroupDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_option_group"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Option\Aggregate\OptionGroupTranslation\OptionGroupTranslationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_option_group_translation"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Option\OptionValueDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_option_value"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Option\Aggregate\OptionValueTranslation\OptionValueTranslationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_option_value_translation"/>
        </service>

        <!-- Verknüpfungen zu Shopware -->
        <service id="Lohndruckerei\Mensura\Core\Content\OptionSet\OptionSetDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_option_set"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\OptionSet\Aggregate\OptionSetGroup\OptionSetGroupDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_option_set_group"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\ProductProfile\ProductProfileDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_product_profile"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\ProductProfile\Aggregate\ProductProfileMaterial\ProductProfileMaterialDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_product_profile_material"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\ProductProfile\Aggregate\ProductProfileOption\ProductProfileOptionDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_product_profile_option"/>
        </service>
        <!-- v0.4.0: Preistabellen, Produktberater (Merkmale, Anwendungsfälle, Zubehör) -->
        <service id="Lohndruckerei\Mensura\Core\Content\PriceTable\PriceTableDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_price_table"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\PriceTable\Aggregate\PriceTableRow\PriceTableRowDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_price_table_row"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Feature\FeatureDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_feature"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Feature\Aggregate\FeatureTranslation\FeatureTranslationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_feature_translation"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\Feature\Aggregate\FeatureValue\FeatureValueDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_feature_value"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\UseCase\UseCaseDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_use_case"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\UseCase\Aggregate\UseCaseTranslation\UseCaseTranslationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_use_case_translation"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\UseCase\Aggregate\UseCaseAssignment\UseCaseAssignmentDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_use_case_assignment"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\AccessoryRule\AccessoryRuleDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_accessory_rule"/>
        </service>
        <service id="Lohndruckerei\Mensura\Core\Content\AccessoryRule\Aggregate\AccessoryRuleTranslation\AccessoryRuleTranslationDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_accessory_rule_translation"/>
        </service>

        <service id="Lohndruckerei\Mensura\Core\Checkout\OrderLineItem\MensuraOrderLineItemDefinition">
            <tag name="shopware.entity.definition" entity="ld_mensura_order_line_item"/>
        </service>
        <service id="Lohndruckerei\Mensura\Extension\ProductExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="Lohndruckerei\Mensura\Extension\OrderLineItemExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="Lohndruckerei\Mensura\Extension\CustomerGroupExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="Lohndruckerei\Mensura\Extension\MediaExtension">
            <tag name="shopware.entity.extension"/>
        </service>
        <service id="Lohndruckerei\Mensura\Extension\LanguageExtension">
            <tag name="shopware.entity.extension"/>
        </service>
    </services>
</container>
